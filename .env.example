# mainnet (Monad, chain 143) or testnet (chain 10143)
NETWORK=mainnet
# Pays the MON gas for every user action. Fund it with a little MON.
RELAYER_PRIVATE_KEY=0x...
# Optional overrides
# RPC_URL=https://rpc.monad.xyz
# ESCROW_ADDRESS=0x...          # otherwise read from shared/deployments.json
# DATA_DIR=./data               # SQLite for ciphertext vaults, notes, profiles
# PORT=8787
# Kimi (Moonshot) for "send mum ₦50k every Friday"
# KIMI_API_KEY=
# KIMI_MODEL=kimi-k2.6
